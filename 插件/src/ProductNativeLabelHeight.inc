// Authorized public Properties-panel field editing. This is a native Windows
// control bridge, not COM or screen/desktop automation. Only this process's
// named controls and the owned output document's selected openings are touched.
std::wstring productControlText(HWND h){wchar_t text[4096]{};DWORD_PTR n{};if(!SendMessageTimeoutW(h,WM_GETTEXT,4096,reinterpret_cast<LPARAM>(text),SMTO_ABORTIFHUNG|SMTO_BLOCK,100,&n))return {};return text;}
std::wstring productControlClass(HWND h){wchar_t name[128]{};GetClassNameW(h,name,128);return name;}
BOOL CALLBACK productFindProperties(HWND h,LPARAM target){DWORD pid{};GetWindowThreadProcessId(h,&pid);if(pid==GetCurrentProcessId()&&IsWindowVisible(h)&&productControlText(h)==L"特性")*reinterpret_cast<HWND*>(target)=h;return TRUE;}
struct ProductHeightField{HWND list{},cell{},edit{};int index{-1},edits{};RECT row{};std::vector<std::wstring> publicFields;};
BOOL CALLBACK productFindHeightList(HWND h,LPARAM data){auto& p=*reinterpret_cast<ProductHeightField*>(data);if(productControlClass(h)!=L"ListBox"||!(GetWindowLongPtrW(h,GWL_STYLE)&LBS_HASSTRINGS))return TRUE;const auto count=SendMessageW(h,LB_GETCOUNT,0,0);if(count<1||count>500)return TRUE;for(int k=0;k<count;++k){const auto n=SendMessageW(h,LB_GETTEXTLEN,k,0);if(n<0||n>2000)return TRUE;std::wstring text(static_cast<std::size_t>(n)+1,0);SendMessageW(h,LB_GETTEXT,k,reinterpret_cast<LPARAM>(text.data()));text.resize(static_cast<std::size_t>(n));if(text==L"文字高度"){p.list=h;p.index=k;} p.publicFields.push_back(text);}if(p.list==h)return FALSE;p.publicFields.clear();return TRUE;}
BOOL CALLBACK productFindHeightCell(HWND h,LPARAM data){auto& p=*reinterpret_cast<ProductHeightField*>(data);if(GetParent(h)!=p.list||!IsWindowVisible(h))return TRUE;RECT r{},client{};GetWindowRect(h,&r);GetClientRect(p.list,&client);POINT point{r.left,r.top};ScreenToClient(p.list,&point);if(point.y>=p.row.top-2&&point.y<p.row.bottom&&point.x>client.right/3){p.cell=h;return FALSE;}return TRUE;}
BOOL CALLBACK productFindHeightEdit(HWND h,LPARAM data){auto& p=*reinterpret_cast<ProductHeightField*>(data);if(IsWindowVisible(h)&&productControlClass(h)==L"Edit"){p.edit=h;++p.edits;}return TRUE;}
void productOwnControlMessages(){MSG message{};const auto end=GetTickCount64()+150;while(GetTickCount64()<end&&PeekMessageW(&message,nullptr,0,0,PM_REMOVE)){TranslateMessage(&message);DispatchMessageW(&message);}}
void productOpeningTextHeights(const AcDbEntity& e,std::vector<double>& result,int depth=0){if(depth>8)return;if(auto* t=AcDbText::cast(&e)){result.push_back(t->height());return;}if(std::wstring(e.isA()->name()).rfind(L"TDb",0)!=0)return;TemplateParts parts(&e);if(e.explode(parts.values)!=Acad::eOk)return;for(int k=0;k<parts.values.length();++k)if(auto* child=AcDbEntity::cast(static_cast<AcRxObject*>(parts.values[k])))productOpeningTextHeights(*child,result,depth+1);}

 else{double left=-1e100,right=1e100;for(const auto& w:walls){if(w.vertical==vertical)continue;const double from=vertical?w.box.minPoint().x:w.box.minPoint().y,to=vertical?w.box.maxPoint().x:w.box.maxPoint().y;if(normal<from-1e-4||normal>to+1e-4)continue;const double a=vertical?w.box.minPoint().y:w.box.minPoint().x,b=vertical?w.box.maxPoint().y:w.box.maxPoint().x;if(b<=low+1e-4)left=std::max(left,b);if(a>=high-1e-4)right=std::min(right,a);}
 const bool leftKnown=left>-1e99,rightKnown=right<1e99;if(!leftKnown&&!rightKnown)reason="未能确定相邻墙体内侧墙面";else{if(!leftKnown)left=host->lo;if(!rightKnown)right=host->hi;const bool useLeft=leftKnown&&(!rightKnown||low-left<=right-high);const double available=right-left;actualGap=useLeft?low-left:right-high;if(!bcpproduct::interiorDoorJambFits(available,width,config.unitMM))reason="固定墙面之间空间不足，不能保留原门宽并留120净垛";else{delta=useLeft?left+jamb-low:right-jamb-high;bool conflict=false;for(auto other:allOpenings){if(other==door)continue;const auto o=chainGrips(other);if(o.size()<3)continue;const bool same=vertical?std::abs(o[1].x-o[2].x)<1e-5:std::abs(o[1].y-o[2].y)<1e-5;if(!same||std::abs((vertical?o[0].x:o[0].y)-normal)>1e-4)continue;const double a=vertical?std::min(o[1].y,o[2].y):std::min(o[1].x,o[2].x),b=vertical?std::max(o[1].y,o[2].y):std::max(o[1].x,o[2].x);if(low+delta<b-1e-4&&high+delta>a+1e-4){conflict=true;break;}}
 if(conflict)reason="按120定位会与已有门窗重叠";else{
 const auto offset=vertical?AcGeVector3d(0,delta,0):AcGeVector3d(delta,0,0);

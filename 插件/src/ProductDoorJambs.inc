void productOpeningTexts(const AcDbEntity& e,std::vector<std::wstring>& out,int depth=0){require(depth<8,"native door text nesting");if(auto* t=AcDbText::cast(&e)){if(*t->textString())out.emplace_back(t->textString());return;}const std::wstring type=e.isA()->name();if(type.rfind(L"TDb",0)!=0)return;TemplateParts parts(&e);productStatus(e.explode(parts.values),"public native opening label");for(int k=0;k<parts.values.length();++k)if(auto* c=AcDbEntity::cast(static_cast<AcRxObject*>(parts.values[k])))productOpeningTexts(*c,out,depth+1);}
void productInteriorDoorJambs(AcDbDatabase& db,const ProductPlanLayoutConfig& config,const fs::path& report){
 Working work(&db);std::vector<ProductJambWall> walls;std::vector<AcDbObjectId> doors,allOpenings,dimensions;
 for(const auto& item:modelTypes(db)){const auto id=find(db,ascii(item.first));if(item.second==L"TDbWall"){const auto g=chainGrips(id);if(g.size()<2)continue;const bool vertical=std::abs(g[0].x-g[1].x)<1e-5,horizontal=std::abs(g[0].y-g[1].y)<1e-5;if(!vertical&&!horizontal)continue;auto e=open<AcDbEntity>(id);AcDbExtents box;productStatus(e->getGeomExtents(box),"actual wall face constraints");walls.push_back({id,vertical,vertical?g[0].x:g[0].y,vertical?std::min(g[0].y,g[1].y):std::min(g[0].x,g[1].x),vertical?std::max(g[0].y,g[1].y):std::max(g[0].x,g[1].x),vertical?box.maxPoint().x-box.minPoint().x:box.maxPoint().y-box.minPoint().y,box});}
 else if(item.second==L"TDbOpening"||item.second==L"TDbGroupOpening"){allOpenings.push_back(id);if(item.second!=L"TDbOpening")continue;auto e=open<AcDbEntity>(id);std::vector<std::wstring> labels;productOpeningTexts(*e,labels);if(std::any_of(labels.begin(),labels.end(),[](const auto& s){return s.size()>1&&s[0]==L'M'&&s[1]>=L'0'&&s[1]<=L'9';}))doors.push_back(id);}
 else if(item.second==L"TDbDimension2"){auto e=open<AcDbEntity>(id);if(e->visibility()==AcDb::kVisible&&symbolName(e->layerId())==L"PUB_DIM")dimensions.push_back(id);}}
 std::ostringstream result;result<<std::setprecision(17)<<'[';bool first=true;const double jamb=120/config.unitMM;
 for(auto door:doors){const auto g=chainGrips(door);require(g.size()>=4,"actual hinged door shape");const bool vertical=std::abs(g[1].x-g[2].x)<1e-5;const double normal=vertical?g[0].x:g[0].y,low=vertical?std::min(g[1].y,g[2].y):std::min(g[1].x,g[2].x),high=vertical?std::max(g[1].y,g[2].y):std::max(g[1].x,g[2].x),width=high-low;const ProductJambWall* host{};for(const auto& w:walls)if(w.vertical==vertical&&std::abs(w.normal-normal)<1e-4&&w.lo<=low+1e-4&&w.hi>=high-1e-4&&(!host||w.hi-w.lo<host->hi-host->lo))host=&w;
 std::string statusText="pending",reason;double delta=0,actualGap=0;int adjusted=0;

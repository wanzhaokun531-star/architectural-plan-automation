 if(!associated)continue;AcDbIntArray selected;bool hasLow=false,hasHigh=false;for(std::size_t k=2;k<=values.size()+2;++k){const double coordinate=vertical?p[k].y:p[k].x;if(std::abs(coordinate-low)<1e-4){selected.append(static_cast<int>(k));hasLow=true;}else if(std::abs(coordinate-high)<1e-4){selected.append(static_cast<int>(k));hasHigh=true;}}if(!hasLow||!hasHigh)continue;{auto e=editObject<AcDbEntity>(dim);productStatus(e->moveGripPointsAt(selected,offset),"follow actual door edges with shared dimension stations");}const auto after=chainValues(dim);require(after.size()==values.size(),"door positioning changed dimension segment membership");require(std::abs(std::accumulate(after.begin(),after.end(),0.0)-std::accumulate(values.begin(),values.end(),0.0))<1e-5,"door positioning changed chain total");++adjusted;
 }
 if(std::abs(delta)>1e-5){auto e=editObject<AcDbEntity>(door);productStatus(e->transformBy(AcGeMatrix3d::translation(offset)),"interior hinged door120 actual net jamb");}const auto after=chainGrips(door);require(std::abs(after[1].distanceTo(after[2])-width)<1e-5,"120jamb changed door opening width");actualGap=useLeft?(vertical?std::min(after[1].y,after[2].y):std::min(after[1].x,after[2].x))-left:right-(vertical?std::max(after[1].y,after[2].y):std::max(after[1].x,after[2].x));require(std::abs(actualGap-jamb)<1e-5,"actual measured net door jamb is not120");statusText=std::abs(delta)>1e-5?"moved":"already-compliant";{auto wall=editObject<AcDbEntity>(host->id);wall->recordGraphicsModified(true);}
 }}}}
 if(!first)result<<',';first=false;result<<"{\"door\":\""<<axisHandle(door)<<"\",\"host\":\""<<(host?axisHandle(host->id):std::string{})<<"\",\"status\":\""<<statusText<<"\",\"translation\":"<<delta<<",\"netJambDrawingUnits\":"<<actualGap<<",\"changedChains\":"<<adjusted<<",\"reason\":"<<jsonUtf8(bcpproduct::decodeMessage(reason))<<'}';
 }
 result<<']';writeNew(report,result.str());
}
